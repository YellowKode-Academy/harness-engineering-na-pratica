{
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "mcp__github__get_pull_request_files",
      "mcp__github__create_review_comment"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(git push:*)",
      "mcp__github__merge_pull_request",
      "mcp__github__delete_file"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/verificar_permissao.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/audit_tool_call.py"
          }
        ]
      }
    ]
  }
}
